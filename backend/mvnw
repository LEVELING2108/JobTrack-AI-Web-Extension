#!/bin/sh
DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -e "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    curl -o "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar
fi

WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain
exec java -Dmaven.multiModuleProjectDirectory="$DIR" -cp "$WRAPPER_JAR" "$WRAPPER_LAUNCHER" "$@"
