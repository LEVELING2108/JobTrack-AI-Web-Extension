# JobTrack Web Frontend Environment Variables

# Backend API base URL (defaults to /api/v1 for Vite proxy)
VITE_API_BASE_URL=/api/v1

# Google OAuth 2.0 Web Client ID
# Obtain this from Google Cloud Console -> APIs & Services -> Credentials
# Example: 1234567890-abcdefg123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
